@model IEnumerable<despachoAeronave.Models.Vuelo>
@{
    ViewData["Title"] = "Programación de Vuelos";
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-premium">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="m-0" style="font-weight: 700; font-size: 16px; color: #1e293b;">Vuelos Registrados</h5>
                    <small class="text-muted">Lista total de operaciones y rutas programadas</small>
                </div>
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm px-3" style="background: linear-gradient(135deg, #0076ff 0%, #0056cc 100%); border: none; border-radius: 8px;">
                    Programar Vuelo
                </a>
            </div>
            <div class="table-responsive p-0">
                <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4" style="color: #64748b; font-weight: 600;">Vuelo</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Origen</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Destino</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Salida</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Llegada</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Aeronave</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Estado</th>
                            <th class="py-3 text-end px-4" style="color: #64748b; font-weight: 600; width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold text-dark">
                                        @item.NumeroVuelo
                                    </td>
                                    <td>
                                        @item.Origen
                                    </td>
                                    <td>
                                        @item.Destino
                                    </td>
                                    <td>
                                        @item.FechaHoraSalida.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @item.FechaHoraLlegada.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (item.Aeronave != null)
                                        {
                                            <span class="fw-semibold">@item.Aeronave.Matricula</span>
                                            <span class="text-muted d-block" style="font-size: 11px;">@item.Aeronave.Modelo</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">No asignada</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Estado == "Programado")
                                        {
                                            <span class="badge badge-custom badge-primary-light">Programado</span>
                                        }
                                        else if (item.Estado == "En Vuelo")
                                        {
                                            <span class="badge badge-custom badge-warning-light">En Vuelo</span>
                                        }
                                        else if (item.Estado == "Aterrizado")
                                        {
                                            <span class="badge badge-custom badge-success-light">Aterrizado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-custom badge-danger-light">Cancelado</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary me-1" style="border-radius: 6px;">
                                            Editar
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;">
                                            Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No hay vuelos programados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
