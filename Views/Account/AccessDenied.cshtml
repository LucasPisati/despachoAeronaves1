                      <path fill-rule="evenodd" d="M1.093 3.093c-.496.496-.907 1.047-1.093 1.636V8c0 5.017 4.24 7.632 7.74 8a12 12 0 0 0 .26.02L8 16c3.837-.367 8-3.5 8-8V4.729c-.067-.201-.157-.393-.27-.573l-1.082 1.082V8c0 3.864-3.197 6.425-6.648 6.776V9.093l-6.907-6.9zm.655.655 8.907 8.907c1.782-1.026 3.324-2.8 4.093-5.26H9.093l-6.907-6.9-.438.438z"/>
