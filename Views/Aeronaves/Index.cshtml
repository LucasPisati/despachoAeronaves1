@model IEnumerable<despachoAeronave.Models.Aeronave>
@{
    ViewData["Title"] = "Gestión de Flota";
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-premium">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="m-0" style="font-weight: 700; font-size: 16px; color: #1e293b;">Flota Registrada</h5>
                    <small class="text-muted">Listado de aeronaves de Aerolíneas Argentinas y sus estados operacionales</small>
                </div>
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm px-3" style="background: linear-gradient(135deg, #0076ff 0%, #0056cc 100%); border: none; border-radius: 8px;">
                    Registrar Aeronave
                </a>
            </div>
            <div class="table-responsive p-0">
                <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4" style="color: #64748b; font-weight: 600;">Matrícula</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Modelo</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Capacidad</th>
                            <th class="py-3" style="color: #64748b; font-weight: 600;">Estado</th>
                            <th class="py-3 text-end px-4" style="color: #64748b; font-weight: 600; width: 200px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold text-dark">
                                        @item.Matricula
                                    </td>
                                    <td>
                                        @item.Modelo
                                    </td>
                                    <td>
                                        @item.CapacidadPasajeros Pasajeros
                                    </td>
                                    <td>
                                        @if (item.Estado == "Activa")
                                        {
                                            <span class="badge badge-custom badge-success-light">Activa</span>
                                        }
                                        else if (item.Estado == "Mantenimiento")
                                        {
                                            <span class="badge badge-custom badge-warning-light">Mantenimiento</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-custom badge-danger-light">Inactiva</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary me-1" style="border-radius: 6px;">
                                            Editar
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;">
                                            Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No hay aeronaves registradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
