@model despachoAeronave.Models.Aeronave
@{
    ViewData["Title"] = "Eliminar Aeronave";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-premium border-danger">
            <div class="card-header bg-danger bg-opacity-10 text-danger">
                <h5 class="m-0" style="font-weight: 700; font-size: 16px;">¿Confirmar eliminación?</h5>
                <small class="text-muted text-danger">Esta acción es irreversible y podría afectar vuelos programados asignados a esta aeronave.</small>
            </div>
            <div class="card-body p-4">
                <p class="mb-4">Está a punto de eliminar el registro de la siguiente aeronave del inventario:</p>
                
                <table class="table table-bordered mb-4">
                    <tr>
                        <th class="bg-light w-30">Matrícula</th>
                        <td class="fw-bold">@Model.Matricula</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Modelo</th>
                        <td>@Model.Modelo</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Capacidad</th>
                        <td>@Model.CapacidadPasajeros Pasajeros</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Estado</th>
                        <td>@Model.Estado</td>
                    </tr>
                </table>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4" style="border-radius: 8px;">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger px-4" style="border-radius: 8px;">
                            Confirmar Eliminación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
